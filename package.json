  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "tslib": "^2.8.1",
    "typescript": "~5.8.3"
  }
}
